LLM_API_KEY=
LLM_MODEL=
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=test_db
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123
# Optional. Otherwise a local signing key is generated in .runtime.
JWT_SECRET=

# Host API and docker compose --env-file .env share these PostgreSQL settings.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=attribution
POSTGRES_USER=attribution
POSTGRES_PASSWORD=attribution-local
# DATABASE_URL optionally overrides the API connection string.
